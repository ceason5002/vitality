<% content_for :title, "Log in - Vitality" %>

<div class="max-w-md mx-auto bg-white rounded-xl shadow-sm border border-slate-200 p-6">
  <h1 class="text-2xl font-bold mb-6">Log in</h1>

  <%= form_with url: login_path, local: true, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :email, class: "block text-sm font-medium mb-1" %>
      <%= f.email_field :email, required: true, class: "w-full rounded-md border-slate-300 shadow-sm" %>
    </div>

    <div>
      <%= f.label :password, class: "block text-sm font-medium mb-1" %>
      <%= f.password_field :password, required: true, class: "w-full rounded-md border-slate-300 shadow-sm" %>
    </div>

    <%= f.submit "Log in", class: "w-full bg-emerald-600 text-white rounded-md py-2 font-medium hover:bg-emerald-700 cursor-pointer" %>
  <% end %>

  <p class="mt-4 text-sm text-slate-600">New here? <%= link_to "Sign up", signup_path, class: "text-emerald-700 underline" %></p>
</div>
