<%= form_with model: workout_template, local: true, class: "space-y-4" do |f| %>
  <% if workout_template.errors.any? %>
    <div class="rounded-md bg-red-50 text-red-700 text-sm p-3">
      <ul class="list-disc list-inside">
        <% workout_template.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium mb-1" %>
    <%= f.text_field :name, required: true, class: "w-full rounded-md border-slate-300 shadow-sm" %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium mb-1" %>
    <%= f.text_area :description, rows: 2, class: "w-full rounded-md border-slate-300 shadow-sm" %>
  </div>

  <h2 class="font-semibold text-sm mt-6">Exercises</h2>
  <p class="text-xs text-slate-500 mb-2">Leave a row's exercise blank to skip it.</p>

  <div class="space-y-3">
    <%= f.fields_for :workout_template_exercises do |wf| %>
      <div class="bg-slate-50 rounded-md p-3 grid grid-cols-12 gap-2 items-end">
        <div class="col-span-4">
          <%= wf.label :exercise_id, "Exercise", class: "block text-xs font-medium mb-1" %>
          <%= wf.collection_select :exercise_id, Exercise.order(:name), :id, :name, { include_blank: true }, class: "w-full rounded-md border-slate-300 text-sm" %>
        </div>
        <div class="col-span-2">
          <%= wf.label :target_sets, "Sets", class: "block text-xs font-medium mb-1" %>
          <%= wf.number_field :target_sets, class: "w-full rounded-md border-slate-300 text-sm" %>
        </div>
        <div class="col-span-2">
          <%= wf.label :target_reps_min, "Min reps", class: "block text-xs font-medium mb-1" %>
          <%= wf.number_field :target_reps_min, class: "w-full rounded-md border-slate-300 text-sm" %>
        </div>
        <div class="col-span-2">
          <%= wf.label :target_reps_max, "Max reps", class: "block text-xs font-medium mb-1" %>
          <%= wf.number_field :target_reps_max, class: "w-full rounded-md border-slate-300 text-sm" %>
        </div>
        <% if wf.object.persisted? %>
          <div class="col-span-2 flex items-center gap-1">
            <%= wf.check_box :_destroy, class: "rounded border-slate-300" %>
            <%= wf.label :_destroy, "Remove", class: "text-xs text-red-600" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= f.submit workout_template.persisted? ? "Save changes" : "Create template", class: "w-full bg-emerald-600 text-white rounded-md py-2 font-medium hover:bg-emerald-700 cursor-pointer" %>
<% end %>
