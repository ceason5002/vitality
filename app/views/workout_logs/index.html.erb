<% content_for :title, "Workout History - Vitality" %>

<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-bold">Workout history</h1>
  <%= link_to "+ Start workout", new_workout_log_path, class: "bg-emerald-600 text-white text-sm px-3 py-1.5 rounded-md hover:bg-emerald-700" %>
</div>

<% if @workout_logs.any? %>
  <ul class="bg-white rounded-lg border border-slate-200 divide-y divide-slate-200">
    <% @workout_logs.each do |log| %>
      <li class="p-3">
        <%= link_to workout_log_path(log), class: "flex items-center justify-between" do %>
          <div>
            <p class="text-sm font-medium"><%= log.workout_template&.name || "Freestyle workout" %></p>
            <p class="text-xs text-slate-500"><%= log.started_at.strftime("%b %-d, %Y %-I:%M %p") %></p>
          </div>
          <span class="text-xs <%= log.completed? ? 'text-emerald-700' : 'text-amber-600' %>">
            <%= log.completed? ? "Completed" : "In progress" %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-sm text-slate-400">No workouts logged yet.</p>
<% end %>
