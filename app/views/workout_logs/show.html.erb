<% content_for :title, "Workout - Vitality" %>

<div class="flex items-center justify-between mb-4">
  <div>
    <h1 class="text-2xl font-bold"><%= @workout_log.workout_template&.name || "Freestyle workout" %></h1>
    <p class="text-xs text-umber-500"><%= @workout_log.started_at.strftime("%b %-d, %Y %-I:%M %p") %></p>
  </div>
  <% if @workout_log.completed? %>
    <span class="text-sm text-verde-700 font-medium">Completed</span>
  <% else %>
    <%= button_to "Finish workout", workout_log_path(@workout_log, complete: true), method: :patch, class: "bg-verde-600 text-white text-sm px-3 py-1.5 rounded-md hover:bg-verde-700 cursor-pointer" %>
  <% end %>
</div>

<% @suggestions.each do |s| %>
  <div class="mb-3 rounded-md p-3 text-sm <%= s.action == :increase_weight ? 'bg-verde-50 text-verde-800 border border-verde-200' : 'bg-amber-50 text-amber-800 border border-amber-200' %>">
    <strong><%= s.exercise.name %>:</strong> <%= s.message %>
  </div>
<% end %>

<% if @workout_log.workout_template.nil? && !@workout_log.completed? %>
  <div class="bg-white rounded-lg border border-umber-200 p-4 mb-4">
    <h2 class="font-semibold text-sm mb-2">Add an exercise</h2>
    <%= form_with model: SetLog.new, url: workout_log_set_logs_path(@workout_log), local: true, class: "flex flex-wrap items-end gap-2" do |f| %>
      <div>
        <%= f.label :exercise_id, "Exercise", class: "block text-xs" %>
        <%= f.collection_select :exercise_id, Exercise.order(:name), :id, :name, { include_blank: true }, class: "rounded-md border-umber-300 text-sm" %>
      </div>
      <div>
        <%= f.label :set_number, "Set #", class: "block text-xs" %>
        <%= f.number_field :set_number, value: 1, class: "w-16 rounded-md border-umber-300 text-sm" %>
      </div>
      <div>
        <%= f.label :weight, class: "block text-xs" %>
        <%= f.number_field :weight, step: 0.5, class: "w-20 rounded-md border-umber-300 text-sm" %>
      </div>
      <div>
        <%= f.label :reps, class: "block text-xs" %>
        <%= f.number_field :reps, class: "w-16 rounded-md border-umber-300 text-sm" %>
      </div>
      <%= f.submit "Add", class: "bg-umber-900 text-white text-sm px-3 py-1.5 rounded-md cursor-pointer" %>
    <% end %>
  </div>
<% end %>

<% @exercises.each do |exercise| %>
  <div class="bg-white rounded-lg border border-umber-200 p-4 mb-4">
    <h2 class="font-semibold mb-2"><%= exercise.name %></h2>

    <% previous = @previous_sets_by_exercise[exercise.id] || [] %>
    <% if previous.any? %>
      <p class="text-xs text-umber-500 mb-2">
        Last time: <%= previous.map { |s| "#{s.weight}x#{s.reps}" }.join(", ") %>
      </p>
    <% end %>

    <% current_sets = (@set_logs_by_exercise[exercise.id] || []).sort_by(&:set_number) %>
    <% if current_sets.any? %>
      <ul class="mb-3 space-y-1">
        <% current_sets.each do |set| %>
          <li class="text-sm flex items-center gap-2">
            <span>Set <%= set.set_number %>: <%= set.weight %> &times; <%= set.reps %><% if set.rpe %> @<%= set.rpe %> RPE<% end %></span>
            <% if set.is_pr? %><span class="text-xs font-semibold text-amber-600">PR</span><% end %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% unless @workout_log.completed? %>
      <%= form_with model: SetLog.new, url: workout_log_set_logs_path(@workout_log), local: true, class: "flex flex-wrap items-end gap-2" do |f| %>
        <%= f.hidden_field :exercise_id, value: exercise.id %>
        <div>
          <%= f.label :set_number, "Set #", class: "block text-xs" %>
          <%= f.number_field :set_number, value: current_sets.size + 1, class: "w-16 rounded-md border-umber-300 text-sm" %>
        </div>
        <div>
          <%= f.label :weight, class: "block text-xs" %>
          <%= f.number_field :weight, step: 0.5, class: "w-20 rounded-md border-umber-300 text-sm" %>
        </div>
        <div>
          <%= f.label :reps, class: "block text-xs" %>
          <%= f.number_field :reps, class: "w-16 rounded-md border-umber-300 text-sm" %>
        </div>
        <div>
          <%= f.label :rpe, "RPE", class: "block text-xs" %>
          <%= f.number_field :rpe, step: 0.5, class: "w-16 rounded-md border-umber-300 text-sm" %>
        </div>
        <%= f.submit "Add set", class: "bg-umber-900 text-white text-sm px-3 py-1.5 rounded-md hover:bg-umber-700 cursor-pointer" %>
      <% end %>
    <% end %>
  </div>
<% end %>
