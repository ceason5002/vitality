<% content_for :title, "Add Food - Vitality" %>

<div class="max-w-md mx-auto bg-white rounded-xl shadow-sm border border-slate-200 p-6">
  <h1 class="text-xl font-bold mb-6">Add a custom food</h1>

  <%= form_with model: @food, url: foods_path, local: true, class: "space-y-4" do |f| %>
    <% if @food.errors.any? %>
      <div class="rounded-md bg-red-50 text-red-700 text-sm p-3">
        <ul class="list-disc list-inside">
          <% @food.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, class: "block text-sm font-medium mb-1" %>
      <%= f.text_field :name, required: true, class: "w-full rounded-md border-slate-300 shadow-sm" %>
    </div>

    <div>
      <%= f.label :brand, class: "block text-sm font-medium mb-1" %>
      <%= f.text_field :brand, class: "w-full rounded-md border-slate-300 shadow-sm" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :serving_size_qty, "Serving size", class: "block text-sm font-medium mb-1" %>
        <%= f.number_field :serving_size_qty, step: 0.1, value: 1, class: "w-full rounded-md border-slate-300 shadow-sm" %>
      </div>
      <div>
        <%= f.label :serving_size_unit, "Unit", class: "block text-sm font-medium mb-1" %>
        <%= f.text_field :serving_size_unit, placeholder: "g, cup, serving...", class: "w-full rounded-md border-slate-300 shadow-sm" %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :calories, class: "block text-sm font-medium mb-1" %>
        <%= f.number_field :calories, step: 0.1, required: true, class: "w-full rounded-md border-slate-300 shadow-sm" %>
      </div>
      <div>
        <%= f.label :protein_g, "Protein (g)", class: "block text-sm font-medium mb-1" %>
        <%= f.number_field :protein_g, step: 0.1, value: 0, class: "w-full rounded-md border-slate-300 shadow-sm" %>
      </div>
      <div>
        <%= f.label :carbs_g, "Carbs (g)", class: "block text-sm font-medium mb-1" %>
        <%= f.number_field :carbs_g, step: 0.1, value: 0, class: "w-full rounded-md border-slate-300 shadow-sm" %>
      </div>
      <div>
        <%= f.label :fat_g, "Fat (g)", class: "block text-sm font-medium mb-1" %>
        <%= f.number_field :fat_g, step: 0.1, value: 0, class: "w-full rounded-md border-slate-300 shadow-sm" %>
      </div>
    </div>

    <%= f.submit "Save food", class: "w-full bg-emerald-600 text-white rounded-md py-2 font-medium hover:bg-emerald-700 cursor-pointer" %>
  <% end %>
</div>
