<% content_for :title, "Exercises - Vitality" %>

<h1 class="text-2xl font-bold mb-4">Exercise library</h1>

<div class="flex flex-wrap gap-2 mb-4">
  <%= link_to "All", exercises_path, class: "px-3 py-1 rounded-full text-sm #{'bg-umber-900 text-white' if @muscle_group.blank?} #{'bg-umber-100 text-umber-700' if @muscle_group.present?}" %>
  <% Exercise.muscle_groups.keys.each do |mg| %>
    <%= link_to mg.humanize, exercises_path(muscle_group: mg), class: "px-3 py-1 rounded-full text-sm #{@muscle_group == mg ? 'bg-umber-900 text-white' : 'bg-umber-100 text-umber-700'}" %>
  <% end %>
</div>

<ul class="bg-white rounded-lg border border-umber-200 divide-y divide-umber-200">
  <% @exercises.each do |exercise| %>
    <li class="p-3">
      <%= link_to exercise.name, exercise_path(exercise), class: "font-medium text-sm text-umber-900 hover:text-verde-700" %>
      <p class="text-xs text-umber-500"><%= exercise.muscle_group.humanize %> &middot; <%= exercise.equipment.humanize %></p>
    </li>
  <% end %>
</ul>
