<% content_for :title, "#{@exercise.name} - Vitality" %>

<%= link_to "← Exercises", exercises_path, class: "text-sm text-slate-500" %>

<h1 class="text-2xl font-bold mt-2"><%= @exercise.name %></h1>
<p class="text-sm text-slate-500 mb-4"><%= @exercise.muscle_group.humanize %> &middot; <%= @exercise.equipment.humanize %></p>

<% if @exercise.instructions.present? %>
  <div class="bg-white rounded-lg border border-slate-200 p-4 mb-6">
    <h2 class="font-semibold text-sm mb-2">Instructions</h2>
    <p class="text-sm text-slate-700 whitespace-pre-line"><%= @exercise.instructions %></p>
  </div>
<% end %>

<h2 class="font-semibold text-sm mb-2">Your recent sets</h2>
<% if @recent_sets.any? %>
  <ul class="bg-white rounded-lg border border-slate-200 divide-y divide-slate-200">
    <% @recent_sets.each do |set| %>
      <li class="p-3 flex items-center justify-between text-sm">
        <span><%= set.weight %> &times; <%= set.reps %><% if set.rpe %> @<%= set.rpe %> RPE<% end %></span>
        <span class="flex items-center gap-2">
          <% if set.is_pr? %><span class="text-xs font-semibold text-amber-600">PR</span><% end %>
          <span class="text-xs text-slate-400"><%= set.created_at.strftime("%b %-d") %></span>
        </span>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-sm text-slate-400">No sets logged yet.</p>
<% end %>
