<% content_for :title, "Sign up - Vitality" %>

<div class="max-w-md mx-auto bg-white rounded-xl shadow-sm border border-umber-200 p-6">
  <%= image_tag "vitality_wordmark.png", alt: "Vitality", class: "h-8 w-auto mx-auto mb-6" %>
  <h1 class="text-2xl font-bold mb-6">Create your account</h1>

  <%= form_with model: @user, url: signup_path, local: true, class: "space-y-4" do |f| %>
    <% if @user.errors.any? %>
      <div class="rounded-md bg-red-50 text-red-700 text-sm p-3">
        <ul class="list-disc list-inside">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, class: "block text-sm font-medium mb-1" %>
      <%= f.text_field :name, required: true, class: "w-full rounded-md border-umber-300 shadow-sm" %>
    </div>

    <div>
      <%= f.label :email, class: "block text-sm font-medium mb-1" %>
      <%= f.email_field :email, required: true, class: "w-full rounded-md border-umber-300 shadow-sm" %>
    </div>

    <div>
      <%= f.label :password, class: "block text-sm font-medium mb-1" %>
      <%= f.password_field :password, required: true, class: "w-full rounded-md border-umber-300 shadow-sm" %>
    </div>

    <div>
      <%= f.label :password_confirmation, class: "block text-sm font-medium mb-1" %>
      <%= f.password_field :password_confirmation, required: true, class: "w-full rounded-md border-umber-300 shadow-sm" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :age, class: "block text-sm font-medium mb-1" %>
        <%= f.number_field :age, class: "w-full rounded-md border-umber-300 shadow-sm" %>
      </div>
      <div>
        <%= f.label :biological_sex, "Biological sex", class: "block text-sm font-medium mb-1" %>
        <%= f.select :biological_sex, User.biological_sexes.keys.map { |k| [k.humanize, k] }, { include_blank: true }, class: "w-full rounded-md border-umber-300 shadow-sm" %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :weight_kg, "Weight (kg)", class: "block text-sm font-medium mb-1" %>
        <%= f.number_field :weight_kg, step: 0.1, class: "w-full rounded-md border-umber-300 shadow-sm" %>
      </div>
      <div>
        <%= f.label :height_cm, "Height (cm)", class: "block text-sm font-medium mb-1" %>
        <%= f.number_field :height_cm, step: 0.1, class: "w-full rounded-md border-umber-300 shadow-sm" %>
      </div>
    </div>

    <div>
      <%= f.label :activity_level, class: "block text-sm font-medium mb-1" %>
      <%= f.select :activity_level, User.activity_levels.keys.map { |k| [k.humanize, k] }, {}, class: "w-full rounded-md border-umber-300 shadow-sm" %>
    </div>

    <div>
      <%= f.label :goal, class: "block text-sm font-medium mb-1" %>
      <%= f.select :goal, User.goals.keys.map { |k| [k.humanize, k] }, {}, class: "w-full rounded-md border-umber-300 shadow-sm" %>
    </div>

    <%= f.submit "Sign up", class: "w-full bg-verde-600 text-white rounded-md py-2 font-medium hover:bg-verde-700 cursor-pointer" %>
  <% end %>

  <p class="mt-4 text-sm text-umber-600">Already have an account? <%= link_to "Log in", login_path, class: "text-verde-700 underline" %></p>
</div>
